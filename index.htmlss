<!DOCTYPE html>
<html :lang="lang" :dir="lang === 'ar' ? 'rtl' : 'ltr'" x-data="osmanArt()" x-init="init()">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Osman Rafaat | Visual Artist</title>
    
    <!-- Scripts -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        serif: ['"Cormorant Garamond"', 'serif'],
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        'art-bg': '#f5f2eb',
                        'art-ink': '#1c1a17',
                        'art-accent': '#8b7355',
                    }
                }
            }
        }
    </script>
    <script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
    <script src="https://upload-widget.cloudinary.com/global/all.js" type="text/javascript"></script>
    <script src="https://unpkg.com/lucide@latest"></script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&family=Inter:wght@200;300;400;500;600&display=swap" rel="stylesheet">

    <style>
        [x-cloak] { display: none !important; }
        
        html { scroll-behavior: smooth; }
        body { background-color: #f5f2eb; color: #1c1a17; font-family: 'Inter', sans-serif; overflow-x: hidden; }

        .serif-italic { font-family: 'Cormorant Garamond', serif; font-style: italic; }
        
        @keyframes fadeIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        .fade-in { animation: fadeIn 1s cubic-bezier(0.16, 1, 0.3, 1) forwards; }

        .modal-backdrop { backdrop-filter: blur(12px); background-color: rgba(28, 26, 23, 0.85); }

        ::-webkit-scrollbar { width: 4px; }
        ::-webkit-scrollbar-track { background: #f5f2eb; }
        ::-webkit-scrollbar-thumb { background: #8b7355; }

        .artwork-image-container img { transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
        .artwork-image-container:hover img { transform: scale(1.05); }

        [dir="rtl"] .modal-row-label { border-right: 2px solid #8b7355; padding-right: 1rem; border-left: 0; padding-left: 0; }
        [dir="ltr"] .modal-row-label { border-left: 2px solid #8b7355; padding-left: 1rem; border-right: 0; padding-right: 0; }
        
        .site-logo { filter: none !important; opacity: 1 !important; transform: none !important; }

        /* ===== New Hero (Museum-style split layout) ===== */
        .hero-split { min-height: 92vh; }
        .hero-frame {
            position: relative;
            background: #ffffff;
            box-shadow: 0 30px 70px -20px rgba(28,26,23,0.35);
        }
        .hero-frame::before{
            content:'';
            position:absolute;
            inset: 14px;
            border: 1px solid rgba(28,26,23,0.08);
            pointer-events: none;
        }
        .hero-eyebrow-line{
            display:flex; align-items:center; gap:14px;
        }
        .hero-eyebrow-line::before{
            content:'';
            width: 36px; height: 1px;
            background: #8b7355;
        }
        [dir="rtl"] .hero-eyebrow-line::before{ order: 2; }
    </style>
</head>
<body class="antialiased">

    <!-- NAVIGATION -->
    <nav class="fixed top-0 left-0 w-full h-24 z-50 flex items-center justify-between px-6 md:px-16 bg-art-bg/90 backdrop-blur-sm border-b border-art-ink/5">
        <a href="#" @click.prevent="window.scrollTo(0, 0)" class="h-14">
            <img src="https://res.cloudinary.com/dz7wu111o/image/upload/FB_IMG_1773195017301_mwbetu.jpg" alt="Logo" class="h-full w-auto rounded-full site-logo shadow-sm border border-art-ink/10">
        </a>
        
        <div class="hidden md:flex gap-12 items-center">
            <div class="flex gap-12 text-[10px] uppercase font-bold tracking-[0.3em] text-art-ink/60">
                <a href="#gallery" class="hover:text-art-accent transition-colors" x-text="t('nav-gallery')"></a>
                <a href="#commission" class="hover:text-art-accent transition-colors" x-text="t('nav-commission')"></a>
                <a href="#about" class="hover:text-art-accent transition-colors" x-text="t('nav-about')"></a>
                <a href="#contact" class="hover:text-art-accent transition-colors" x-text="t('nav-contact')"></a>
            </div>
            
            <button @click="toggleLang()" class="px-4 py-2 border border-art-ink/10 text-[10px] font-bold hover:bg-art-ink hover:text-white transition-all rounded-full min-w-[3rem]" x-text="lang === 'en' ? 'ع' : 'EN'"></button>
        </div>

        <div class="flex gap-4 md:hidden">
            <button @click="toggleLang()" class="px-3 py-1 border border-art-ink/10 text-[8px] font-bold rounded-full" x-text="lang === 'en' ? 'ع' : 'EN'"></button>
            <button @click="mobileMenu = !mobileMenu" class="p-2">
                <i data-lucide="menu"></i>
            </button>
        </div>
    </nav>

    <!-- MOBILE MENU -->
    <div x-show="mobileMenu" x-cloak x-transition.opacity class="fixed inset-0 z-[60] bg-art-bg flex flex-col items-center justify-center gap-12">
        <button @click="mobileMenu = false" class="absolute top-8 left-8 p-4"><i data-lucide="x"></i></button>
        <a href="#gallery" @click="mobileMenu = false" class="text-4xl serif-italic" x-text="t('nav-gallery')"></a>
        <a href="#commission" @click="mobileMenu = false" class="text-4xl serif-italic" x-text="t('nav-commission')"></a>
        <a href="#about" @click="mobileMenu = false" class="text-4xl serif-italic" x-text="t('nav-about')"></a>
        <a href="#contact" @click="mobileMenu = false" class="text-4xl serif-italic" x-text="t('nav-contact')"></a>
    </div>

    <!-- MAIN SITE VIEW -->
    <div x-show="view === 'site'">
        <!-- HERO SECTION (museum split layout) -->
        <section class="hero-split relative w-full flex items-center pt-24 pb-16 px-6 md:px-16 lg:px-24">
            <div class="max-w-7xl mx-auto w-full grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-20 items-center">

                <!-- Text side -->
                <div class="fade-in order-2 lg:order-1" :class="lang === 'ar' ? 'text-right' : 'text-left'">
                    <div class="hero-eyebrow-line text-[10px] uppercase tracking-[0.4em] font-bold text-art-ink/50 mb-10" x-text="t('hero-tagline')"></div>
                    <h1 class="text-6xl md:text-8xl serif-italic font-medium leading-[0.95] mb-8" x-text="t('artist-name')"></h1>
                    <p class="text-lg md:text-xl font-light opacity-70 mb-3" x-text="t('artist-subtitle')"></p>
                    <span class="block text-sm italic opacity-50 mb-12" x-text="`&quot;${t('hero-quote')}&quot;`"></span>
                    <a href="#gallery" class="inline-flex items-center gap-3 px-8 py-4 border border-art-ink/15 text-[10px] uppercase font-bold tracking-[0.3em] hover:bg-art-ink hover:text-white transition-all">
                        <span x-text="t('section-gallery')"></span>
                        <i data-lucide="arrow-down" class="w-3.5 h-3.5"></i>
                    </a>
                </div>

                <!-- Featured artwork side -->
                <div class="order-1 lg:order-2 fade-in" style="animation-delay: 150ms">
                    <div class="hero-frame p-3 md:p-5 max-w-md mx-auto lg:max-w-none">
                        <img src="https://res.cloudinary.com/dz7wu111o/image/upload/v1777284743/vr8bw1bftsbke0fbydld.jpg" alt="Featured Work" class="w-full h-auto shadow-sm">
                    </div>
                    <p class="text-center mt-6 text-[10px] uppercase tracking-[0.3em] font-bold text-art-ink/40" x-text="t('hero-featured-caption')"></p>
                </div>

            </div>
        </section>

        <!-- GALLERY SECTION -->
        <section id="gallery" class="py-32 px-6 md:px-16 lg:px-32">
            <div class="max-w-7xl mx-auto">
                <div class="flex flex-col md:flex-row justify-between items-baseline mb-24">
                    <div class="fade-in">
                        <h2 class="text-5xl md:text-8xl serif-italic mb-6" x-text="t('section-gallery')"></h2>
                        <div class="h-1.5 w-32 bg-art-accent"></div>
                    </div>
                </div>

                <div x-show="loading" class="text-center py-24 opacity-30 italic serif-italic text-xl" x-text="t('loading')"></div>
                <div x-show="!loading && galleryArtworks.length === 0" class="text-center py-24 opacity-30 italic serif-italic text-xl" x-text="t('coming-soon')"></div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-16 gap-y-32" x-show="!loading">
                    <template x-for="(art, idx) in galleryArtworks" :key="idx">
                        <div @click="openArt(art)" class="group cursor-pointer fade-in" :style="`animation-delay: ${idx * 100}ms`">
                            <div class="aspect-[4/5] bg-neutral-200 overflow-hidden relative shadow-2xl artwork-image-container">
                                <img :src="art.image" :alt="art.title" class="w-full h-full object-cover">
                                <div class="absolute inset-0 bg-art-ink/10 opacity-0 group-hover:opacity-100 transition-all duration-700 flex items-center justify-center">
                                    <span class="px-8 py-3 bg-white/10 backdrop-blur-md text-white text-[10px] uppercase font-bold tracking-[0.3em] border border-white/20" x-text="t('view-piece')"></span>
                                </div>
                            </div>
                            <div class="mt-8 flex justify-between items-start">
                                <div class="max-w-[70%]">
                                    <h3 class="text-2xl serif-italic font-medium leading-none mb-3" x-text="art.title"></h3>
                                    <p class="text-[10px] uppercase font-black text-art-ink/30 tracking-[0.2em]" x-text="`${art.medium} · ${art.year}`"></p>
                                </div>
                            </div>
                        </div>
                    </template>
                </div>
            </div>
        </section>

        <!-- ABOUT SECTION -->
        <section id="about" class="bg-art-ink text-[#f5f2eb] py-40 px-6 md:px-16 lg:px-32">
            <div class="max-w-4xl mx-auto text-center">
                <div class="flex flex-col justify-center">
                    <span class="text-art-accent text-[10px] uppercase font-black tracking-[0.4em] mb-12 block" x-text="t('artist-statement')"></span>
                    <h2 class="text-5xl md:text-8xl serif-italic mb-12 leading-tight" x-text="t('about-title')"></h2>
                    
                    <div class="space-y-8 font-light text-lg md:text-xl leading-relaxed text-white/70">
                        <p x-text="t('about-p1')"></p>
                        <p x-text="t('about-p2')"></p>
                        <p x-text="t('about-p3')"></p>
                        
                        <div class="pt-8">
                            <p class="serif-italic italic text-3xl text-white inline-block border-l-2 border-art-accent pl-8" 
                               :class="lang === 'ar' ? 'border-l-0 border-r-2 pr-8 pl-0 text-right' : 'text-left'"
                               x-text="t('about-quote')"></p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- COMMISSION SECTION -->
        <section id="commission" class="py-32 px-6 md:px-16 lg:px-32 border-t border-art-ink/5">
            <div class="max-w-4xl mx-auto">
                <div class="text-center mb-16">
                    <h2 class="text-4xl md:text-6xl serif-italic mb-8" x-text="t('section-commission')"></h2>
                    <p class="text-lg font-light opacity-70" x-text="t('commission-desc')"></p>
                </div>

                <form @submit.prevent="sendCommission()" class="grid grid-cols-1 md:grid-cols-2 gap-8 bg-white p-8 md:p-12 shadow-xl border border-art-ink/5">
                    <div class="space-y-6">
                        <div>
                            <label class="block text-[10px] uppercase font-black tracking-widest mb-2 opacity-40" x-text="t('form-name')"></label>
                            <input type="text" x-model="commForm.name" required class="w-full border-b border-art-ink/10 py-3 outline-none focus:border-art-accent bg-transparent">
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase font-black tracking-widest mb-2 opacity-40" x-text="t('form-email')"></label>
                            <input type="email" x-model="commForm.email" required class="w-full border-b border-art-ink/10 py-3 outline-none focus:border-art-accent bg-transparent">
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase font-black tracking-widest mb-2 opacity-40" x-text="t('form-subject')"></label>
                            <input type="text" x-model="commForm.subject" required class="w-full border-b border-art-ink/10 py-3 outline-none focus:border-art-accent bg-transparent">
                        </div>
                    </div>
                    <div>
                        <label class="block text-[10px] uppercase font-black tracking-widest mb-2 opacity-40" x-text="t('form-vision')"></label>
                        <textarea x-model="commForm.vision" required class="w-full border border-art-ink/10 p-4 h-full outline-none focus:border-art-accent bg-transparent resize-none md:min-h-[200px]"></textarea>
                    </div>
                    <div class="md:col-span-2">
                        <button type="submit" class="w-full py-5 bg-art-ink text-white text-[10px] uppercase font-black tracking-[0.3em] hover:bg-art-accent transition-all" x-text="t('form-submit')"></button>
                    </div>
                </form>
            </div>
        </section>

        <!-- FOOTER -->
        <footer id="contact" class="py-32 px-6 border-t border-art-ink/5 text-center">
            <div class="max-w-2xl mx-auto flex flex-col items-center">
                <img src="https://res.cloudinary.com/dz7wu111o/image/upload/FB_IMG_1773195017301_mwbetu.jpg" alt="Logo" class="h-24 w-24 rounded-full mb-12 site-logo">
                <p class="text-[10px] uppercase font-black tracking-[0.4em] mb-12 opacity-30 italic" x-text="t('footer-copy')"></p>
                
                <div class="flex flex-col md:flex-row gap-6 w-full">
                    <a href="tel:01122633026" class="flex-1 px-8 py-5 border border-art-ink/10 text-[10px] uppercase font-bold tracking-widest hover:bg-art-ink hover:text-white transition-all flex items-center justify-center gap-2">
                        01122633026
                    </a>
                    <a href="https://wa.me/201026933840" target="_blank" class="flex-1 px-8 py-5 bg-art-ink text-white text-[10px] uppercase font-bold tracking-widest hover:bg-art-accent transition-all flex items-center justify-center gap-2">
                        WhatsApp
                    </a>
                </div>
            </div>
        </footer>
    </div>

    <!-- ARTWORK MODAL -->
    <div x-show="showModal" x-cloak class="fixed inset-0 z-[100] flex items-center justify-center p-4">
        <div class="absolute inset-0 modal-backdrop" @click="showModal = false"></div>
        <div class="bg-art-bg w-full max-w-6xl max-h-[90vh] overflow-y-auto relative shadow-2xl flex flex-col lg:flex-row fade-in">
            <button @click="showModal = false" class="absolute top-8 left-8 z-20 p-3 hover:bg-art-ink/5 rounded-full transition-all">
                <i data-lucide="x"></i>
            </button>
            <div class="lg:w-3/5 bg-neutral-200 flex items-center justify-center p-8 md:p-12 lg:p-24">
                <img :src="selectedArt?.image" :alt="selectedArt?.title" class="max-w-full max-h-[70vh] shadow-2xl">
            </div>
            <div class="lg:w-2/5 p-12 md:p-20 flex flex-col" :class="lang === 'ar' ? 'text-right' : ''">
                <div class="flex-1">
                    <h3 class="text-4xl md:text-6xl serif-italic mb-4" x-text="selectedArt?.title"></h3>
                    <div x-show="selectedArt?.description" class="p-6 bg-art-ink/5 italic serif-italic text-lg mb-12 border-l-4 border-art-accent">
                        <p x-text="selectedArt?.description"></p>
                    </div>
                    <div class="space-y-6 pt-12 border-t border-art-ink/10 text-[10px] uppercase font-bold tracking-[0.2em] opacity-80">
                        <div class="flex justify-between border-b border-art-ink/5 pb-4">
                            <span class="opacity-40" x-text="t('label-dims')"></span>
                            <span x-text="selectedArt?.dimensions"></span>
                        </div>
                        <div class="flex justify-between border-b border-art-ink/5 pb-4" x-show="selectedArt?.price">
                            <span class="opacity-40" x-text="t('label-price')"></span>
                            <span x-text="selectedArt?.price"></span>
                        </div>
                        <div class="flex justify-between border-b border-art-ink/5 pb-4">
                            <span class="opacity-40" x-text="t('label-medium')"></span>
                            <span x-text="selectedArt?.medium"></span>
                        </div>
                        <div class="flex justify-between border-b border-art-ink/5 pb-4">
                            <span class="opacity-40" x-text="t('label-year')"></span>
                            <span x-text="selectedArt?.year"></span>
                        </div>
                    </div>
                    <div class="mt-12 space-y-4">
                        <label class="block text-[10px] uppercase font-black tracking-widest opacity-40 mb-2" x-text="t('label-message')"></label>
                        <textarea x-model="visitorMessage" :placeholder="t('message-placeholder')" class="w-full p-4 bg-white border border-art-ink/10 text-sm outline-none focus:border-art-accent min-h-[100px] resize-none"></textarea>
                    </div>
                </div>
                <div class="mt-12">
                    <button @click="sendArtInquiry()" class="block w-full bg-art-ink text-white py-5 text-[10px] uppercase font-black tracking-[0.3em] text-center hover:bg-art-accent transition-all" x-text="t('form-submit')"></button>
                </div>
            </div>
        </div>
    </div>

    <script>
        const TRANSLATIONS = {
            en: {
                'nav-gallery': 'Gallery', 'nav-commission': 'Commission', 'nav-about': 'About', 'nav-contact': 'Contact',
                'hero-tagline': "Earth's Truth, Color's Freedom", 'artist-name': 'Osman Rafaat', 'artist-subtitle': 'Visual Artist · Minya, Egypt',
                'hero-quote': "Earth's Truth, Color's Freedom", 'hero-featured-caption': 'Featured Work · Nile Boat',
                'section-gallery': 'Selected Works', 'loading': 'Loading atmosphere...',
                'coming-soon': 'New works coming soon.', 'view-piece': 'View Piece', 'artist-statement': 'Artist Statement',
                'about-title': 'The Nile runs past my window.',
                'about-p1': 'I grew up in a village in Minya, Upper Egypt — where the river is not a metaphor, it is a neighbor. Where ancient walls speak in three languages at once: Pharaonic, Islamic, Coptic.',
                'about-p2': 'I studied at the Faculty of Specific Education, Fine Arts Department, Assiut University, but I have always painted from instinct before theory. I am drawn to heritage — not as nostalgia, but as a living thing. Something still breathing in the mud-brick walls, in the geometry of a minaret, in the face of a farmer at dusk.',
                'about-p3': 'My style is not yet complete — and that is precisely what makes every painting different from the one before it.',
                'about-quote': 'Everything I paint begins here.',
                'section-commission': 'Commission a Piece', 'commission-desc': 'Whether a landscape, a heritage-inspired piece, or a specific size to fit your space—I welcome custom inquiries that resonate with the spirit of the Nile.',
                'form-name': 'Full Name', 'form-email': 'Email Address', 'form-vision': 'Your Vision', 'form-subject': 'Subject', 'form-submit': '✉ Send via Email',
                'footer-copy': '© 2026 Osman Rafaat · All Rights Reserved', 'label-dims': 'Dimensions', 'label-medium': 'Medium', 'label-year': 'Year', 'label-price': 'Price',
                'label-message': 'Your Message / Question', 'message-placeholder': 'Is this piece still available? I would like to know more about its history...'
            },
            ar: {
                'nav-gallery': 'المعرض', 'nav-commission': 'طلب خاص', 'nav-about': 'عن الفنان', 'nav-contact': 'تواصل',
                'hero-tagline': "صدق الأرض، حرية الألوان", 'artist-name': 'عثمان رأفت', 'artist-subtitle': 'فنان تشكيلي · المنيا، صعيد مصر',
                'hero-quote': "صدق الأرض، حرية الألوان", 'hero-featured-caption': 'عمل مختار · مركب النيل',
                'section-gallery': 'أعمال مختارة', 'loading': 'جاري تحميل الأعمال...',
                'coming-soon': 'أعمال جديدة قريباً.', 'view-piece': 'عرض اللوحة', 'artist-statement': 'رؤية فنية',
                'about-title': 'النيل يجري أمام نافذتي.',
                'about-p1': 'نشأت في قرية في المنيا، صعيد مصر — حيث النهر ليس استعارة، بل جار. حيث الجدران القديمة تتحدث بثلاث لغات في آن واحد: فرعونية، إسلامية، قبطية.',
                'about-p2': 'درست في كلية التربية النوعية، قسم التربية الفنية، جامعة أسيوط، لكنني دائمًا ما أرسم بالفطرة قبل النظرية. تنجذب روحي للتراث — ليس كحنين، ولكن كشيء حي. شيء لا يزال ينبض بين جدران الطوب اللبن، وفي هندسة المآذن، وفي وجه فلاح وقت الغسق.',
                'about-p3': 'أسلوبي لم يكتمل بعد — وهذا بالضبط ما يجعل كل لوحة مختلفة عن سابقتها.',
                'about-quote': 'كل ما أرسمه يبدأ من هنا.',
                'section-commission': 'اطلب عملك الخاص', 'commission-desc': 'سواء كان منظراً طبيعياً، أو عملاً مستوحى من التراث، أو مقاساً خاصاً ليناسب مساحتك—أرحب بالطلبات المخصصة التي تحاكي روح النيل.',
                'form-name': 'الاسم بالكامل', 'form-email': 'البريد الإلكتروني', 'form-vision': 'رؤيتك للعمل', 'form-subject': 'الموضوع', 'form-submit': '✉ إرسال عبر البريد',
                'footer-copy': '© 2026 عثمان رأفت · جميع الحقوق محفوظة', 'label-dims': 'الأبعاد', 'label-medium': 'الخامة', 'label-year': 'السنة', 'label-price': 'السعر',
                'label-message': 'رسالتك / استفسارك', 'message-placeholder': 'هل هذه اللوحة لا تزال متاحة؟ أود معرفة المزيد عن تاريخها...'
            }
        };

        function osmanArt() {
            return {
                lang: localStorage.getItem('osman_lang') || 'en', view: 'site', loading: true, mobileMenu: false, showModal: false, selectedArt: null, visitorMessage: '', artworks: [],
                get galleryArtworks() { return this.artworks.filter(art => !art.type || art.type === 'gallery'); },
                get aboutArtworks() { return this.artworks.filter(art => art.type === 'about'); },
                commForm: { name: '', email: '', subject: '', vision: '' },
                init() { this.loadArtworks(); setTimeout(() => lucide.createIcons(), 500); },
                t(key) { return TRANSLATIONS[this.lang][key] || key; },
                toggleLang() { this.lang = this.lang === 'en' ? 'ar' : 'en'; localStorage.setItem('osman_lang', this.lang); },
                async loadArtworks() {
                    this.loading = true;
                    try {
                        const SHEET_URL = 'https://docs.google.com/spreadsheets/d/e/2PACX-1vSiChHx_Y9xUhLWb42AXOVrqUMVSUa-G01laFnTo3IZgE2HLPnUSmpHiZhBy79rluBUyYvshSuCDreI/pub?output=csv';
                        const response = await fetch('https://corsproxy.io/?' + encodeURIComponent(SHEET_URL));
                        const text = await response.text();
                        this.artworks = this.parseCSV(text);
                    } catch (e) { console.error('Load artworks failed', e); }
                    this.loading = false;
                },
                parseCSV(text) {
                    const LOGO_URL = 'https://res.cloudinary.com/dz7wu111o/image/upload/FB_IMG_1773195017301_mwbetu.jpg';
                    const rows = [];
                    let result = [];
                    let cell = '';
                    let inQuotes = false;
                    
                    for (let i = 0; i < text.length; i++) {
                        const char = text[i];
                        const nextChar = text[i + 1];
                        
                        if (char === '"' && inQuotes && nextChar === '"') {
                            cell += '"';
                            i++;
                        } else if (char === '"') {
                            inQuotes = !inQuotes;
                        } else if (char === ',' && !inQuotes) {
                            result.push(cell.trim());
                            cell = '';
                        } else if ((char === '\n' || char === '\r') && !inQuotes) {
                            if (cell !== '' || result.length > 0) {
                                result.push(cell.trim());
                                rows.push(result);
                                result = [];
                                cell = '';
                            }
                            if (char === '\r' && nextChar === '\n') i++;
                        } else {
                            cell += char;
                        }
                    }
                    if (result.length > 0 || cell !== '') {
                        result.push(cell.trim());
                        rows.push(result);
                    }

                    return rows.slice(1).map(result => {
                        if (result.length < 7) return null;
                        const art = { 
                            id: result[0], 
                            title: result[1], 
                            year: result[2], 
                            medium: result[3], 
                            price: result[4], 
                            dimensions: result[5], 
                            image: result[6], 
                            description: result[7] || '', 
                            type: (result[8] || '').toLowerCase().trim() 
                        };
                        if (art.image === LOGO_URL) return null;
                        return art;
                    }).filter(Boolean);
                },
                openArt(art) { this.selectedArt = art; this.visitorMessage = ''; this.showModal = true; setTimeout(() => lucide.createIcons(), 50); },
                sendArtInquiry() {
                    const priceInfo = this.selectedArt.price ? `\nالسعر: ${this.selectedArt.price}` : '';
                    const text = `مرحباً عثمان، أنا مهتم بعملك الفني: ${this.selectedArt.title}\nالأبعاد: ${this.selectedArt.dimensions}${priceInfo}\nالخامة: ${this.selectedArt.medium}\n\nرسالة من الزائر: ${this.visitorMessage}`;
                    window.open(`https://wa.me/201026933840?text=${encodeURIComponent(text)}`, '_blank');
                },
                sendCommission() {
                    window.location.href = `mailto:osmanrafaat05@gmail.com?subject=${encodeURIComponent(this.commForm.subject)}&body=${encodeURIComponent(`الاسم: ${this.commForm.name}\n${this.commForm.vision}`)}`;
                    this.commForm = { name: '', email: '', subject: '', vision: '' };
                }
            }
        }
    </script>
</body>
</html>
